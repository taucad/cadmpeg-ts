{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "runtime"],
    "runtime": [
      {
        "runtime": "node --version"
      },
      {
        "runtime": "pnpm --version"
      },
      {
        "runtime": "rustc --version"
      },
      {
        "runtime": "command -v wasm-bindgen >/dev/null 2>&1 && wasm-bindgen --version || echo wasm-bindgen-absent"
      },
      {
        "runtime": "pnpm exec wasm-opt --version"
      }
    ]
  },
  "release": {
    "projects": ["cadmpeg-ts"],
    "projectsRelationship": "fixed",
    "version": {
      "specifierSource": "version-plans",
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "versionPlans": {
      "ignorePatternsForPlanCheck": [
        "**/*.test.*",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "MAINTAINER.md",
        "SECURITY.md",
        "osv-scanner.toml",
        ".github/**",
        "tests/**",
        "nx.json",
        "scripts/check-prepared-release.mjs",
        "scripts/inspect-native.mjs",
        "scripts/lib/napi-targets.mjs",
        "scripts/pack-test-tarballs.mjs",
        "scripts/registry-wait.mjs",
        "scripts/test-package.mjs",
        "scripts/verify-preview-install.mjs",
        "scripts/verify-release-attestations.mjs"
      ]
    },
    "changelog": {
      "projectChangelogs": {
        "file": "CHANGELOG.md",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "releaseTag": {
      "pattern": "v{version}"
    },
    "git": {
      "commit": false,
      "push": false,
      "stageChanges": false,
      "tag": false
    }
  },
  "analytics": false
}
