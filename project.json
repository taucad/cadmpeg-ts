{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "cadmpeg-ts",
  "root": ".",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build"
      }
    },
    "build:napi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build:napi"
      }
    },
    "build:wasm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build:wasm"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:coverage"
      }
    },
    "test:rust": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:rust"
      }
    },
    "test:browser": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:browser"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck"
      }
    },
    "validate-pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm run validate-pack"
      }
    },
    "check:size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm run check:size"
      }
    },
    "check:dead-code": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run check:dead-code"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run format:check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint"
      }
    },
    "prose": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run prose"
      }
    },
    "workflows": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run workflows"
      }
    },
    "docs-prose": {
      "executor": "nx:noop",
      "dependsOn": ["check:dead-code", "format", "lint", "prose", "workflows"]
    },
    "quality": {
      "executor": "nx:noop",
      "dependsOn": ["check:dead-code", "format", "lint", "prose", "test", "typecheck", "workflows"]
    }
  }
}
