+// SPDX-License-Identifier: Apache-2.0
+//! Seekable scratch storage for writers that assemble an archive before
+//! copying it to a forward-only output.
+
+use std::io::{self, Cursor, Read, Seek, SeekFrom, Write};
+
+/// Scratch storage a writer can write, seek and read back.
+///
+/// Native builds stage in an anonymous temporary file, so a large archive
+/// does not have to fit in memory twice. Targets without a filesystem
+/// (`wasm32-unknown-unknown`) stage in memory instead: there,
+/// `tempfile::tempfile()` panics because `std::env::temp_dir` is unsupported.
+#[derive(Debug)]
+pub enum StagingBuffer {
+    /// An anonymous temporary file.
+    #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+    File(std::fs::File),
+    /// An in-memory buffer.
+    Memory(Cursor<Vec<u8>>),
+}
+
+/// Opens scratch storage suited to the target.
+///
+/// # Errors
+///
+/// Returns the I/O error from creating the temporary file on native targets.
+pub fn staging_buffer() -> io::Result<StagingBuffer> {
+    #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+    {
+        tempfile::tempfile().map(StagingBuffer::File)
+    }
+    #[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+    {
+        Ok(StagingBuffer::Memory(Cursor::new(Vec::new())))
+    }
+}
+
+impl Read for StagingBuffer {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        match self {
+            #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+            Self::File(file) => file.read(buf),
+            Self::Memory(cursor) => cursor.read(buf),
+        }
+    }
+}
+
+impl Write for StagingBuffer {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        match self {
+            #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+            Self::File(file) => file.write(buf),
+            Self::Memory(cursor) => cursor.write(buf),
+        }
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        match self {
+            #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+            Self::File(file) => file.flush(),
+            Self::Memory(cursor) => cursor.flush(),
+        }
+    }
+}
+
+impl Seek for StagingBuffer {
+    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
+        match self {
+            #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+            Self::File(file) => file.seek(pos),
+            Self::Memory(cursor) => cursor.seek(pos),
+        }
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::{staging_buffer, StagingBuffer};
+    use std::io::{Cursor, Read, Seek, SeekFrom, Write};
+
+    fn round_trip(mut staged: StagingBuffer) {
+        staged.write_all(b"cadmpeg").unwrap();
+        staged.seek(SeekFrom::Start(3)).unwrap();
+        staged.write_all(b"P").unwrap();
+        staged.flush().unwrap();
+        staged.seek(SeekFrom::Start(0)).unwrap();
+        let mut read = String::new();
+        staged.read_to_string(&mut read).unwrap();
+        assert_eq!(read, "cadPpeg");
+    }
+
+    #[test]
+    fn target_staging_round_trips() {
+        round_trip(staging_buffer().unwrap());
+    }
+
+    #[test]
+    fn memory_staging_round_trips() {
+        round_trip(StagingBuffer::Memory(Cursor::new(Vec::new())));
+    }
+}
