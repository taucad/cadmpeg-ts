+// SPDX-License-Identifier: Apache-2.0
+//! Clocks that degrade instead of panicking on targets without one.
+//!
+//! On `wasm32-unknown-unknown` the standard library's `Instant::now` and
+//! `SystemTime::now` panic ("time not implemented on this platform"). Decode
+//! timings there read as zero and generated timestamps fall back to the Unix
+//! epoch, so the same decoders and writers run in a browser.
+
+use std::time::{Duration, SystemTime};
+
+/// Measures elapsed wall time for diagnostics.
+#[derive(Debug, Clone, Copy)]
+pub struct Stopwatch {
+    #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+    started: std::time::Instant,
+}
+
+impl Stopwatch {
+    /// Starts measuring.
+    #[must_use]
+    pub fn start() -> Self {
+        Self {
+            #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+            started: std::time::Instant::now(),
+        }
+    }
+
+    /// Time since [`Stopwatch::start`]; zero where the target has no clock.
+    #[must_use]
+    pub fn elapsed(&self) -> Duration {
+        #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+        {
+            self.started.elapsed()
+        }
+        #[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+        {
+            Duration::ZERO
+        }
+    }
+}
+
+/// The current system time; the Unix epoch where the target has no clock.
+#[must_use]
+pub fn system_now() -> SystemTime {
+    #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+    {
+        SystemTime::now()
+    }
+    #[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+    {
+        SystemTime::UNIX_EPOCH
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{system_now, Stopwatch};
+    use std::time::SystemTime;
+
+    #[test]
+    fn stopwatch_is_monotonic() {
+        let watch = Stopwatch::start();
+        let first = watch.elapsed();
+        assert!(watch.elapsed() >= first);
+    }
+
+    #[test]
+    fn system_now_is_after_the_epoch_natively() {
+        assert!(system_now() > SystemTime::UNIX_EPOCH);
+    }
+}
